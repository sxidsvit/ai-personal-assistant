{
  "name": "personal-assistant",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env --import ./src/instrument.ts src/index.ts",
    "build": "tsc",
    "start": "node --import ./dist/src/instrument.js dist/src/index.js",
    "db:studio": "node --env-file=.env ./node_modules/.bin/drizzle-kit studio",
    "db:push": "node --env-file=.env ./node_modules/.bin/drizzle-kit push"
  },
  "dependencies": {
    "@daytona/sdk": "^0.227.0",
    "@hono/node-server": "^2.1.3",
    "@linqapp/sdk": "^0.78.0",
    "@neon/ai-sdk-provider": "^1.3.0",
    "@neon/config": "^1.9.5",
    "@neon/env": "^1.6.6",
    "@sentry/node": "^11.11.0",
    "@trigger.dev/sdk": "4.8.3",
    "ai": "^7.0.157",
    "drizzle-orm": "^0.45.4",
    "firecrawl-aisdk": "^0.13.1",
    "hono": "^4.13.14",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@hono/cli": "^1.0.0-rc.8",
    "@sentry/esbuild-plugin": "^11.11.0",
    "@trigger.dev/build": "4.8.3",
    "@types/node": "^26.1.1",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.0",
    "typescript": "^7.0.2"
  }
}
